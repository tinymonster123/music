# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/release
!.yarn/versions
/.vscode
dist

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

#test
/__test__

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 环境变量
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# SSH keys
src/ssh/*
!src/ssh/.gitkeep

# Docker secrets
secrets/
*.txt
